<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
  <!-- Background -->
  <rect width="512" height="512" rx="96" fill="#0C0B09"/>
  <!-- Gradient overlay -->
  <defs>
    <radialGradient id="glow" cx="50%" cy="40%" r="60%">
      <stop offset="0%" stop-color="#F5A535" stop-opacity="0.15"/>
      <stop offset="100%" stop-color="#0C0B09" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="plate" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F5A535"/>
      <stop offset="100%" stop-color="#C4720D"/>
    </linearGradient>
  </defs>
  <rect width="512" height="512" rx="96" fill="url(#glow)"/>
  <!-- Plate circle -->
  <circle cx="256" cy="230" r="130" fill="none" stroke="url(#plate)" stroke-width="12"/>
  <!-- Fork -->
  <rect x="168" y="120" width="10" height="80" rx="5" fill="#E8901A"/>
  <rect x="156" y="120" width="8" height="40" rx="4" fill="#E8901A"/>
  <rect x="180" y="120" width="8" height="40" rx="4" fill="#E8901A"/>
  <!-- Knife -->
  <rect x="334" y="120" width="10" height="80" rx="5" fill="#E8901A"/>
  <path d="M334 120 Q344 140 344 160 L334 160 Z" fill="#F5A535"/>
  <!-- Steam lines -->
  <path d="M220 80 Q215 65 220 50 Q225 35 220 20" stroke="#F5A535" stroke-width="5" fill="none" stroke-linecap="round" opacity="0.6"/>
  <path d="M256 75 Q251 60 256 45 Q261 30 256 15" stroke="#F5A535" stroke-width="5" fill="none" stroke-linecap="round" opacity="0.8"/>
  <path d="M292 80 Q287 65 292 50 Q297 35 292 20" stroke="#F5A535" stroke-width="5" fill="none" stroke-linecap="round" opacity="0.6"/>
  <!-- DarnaFood text -->
  <text x="256" y="410" font-family="Arial, sans-serif" font-size="52" font-weight="900" fill="url(#plate)" text-anchor="middle">DarnaFood</text>
  <text x="256" y="455" font-family="Arial, sans-serif" font-size="28" fill="#8A7E6F" text-anchor="middle">دارنا فود</text>
</svg>
